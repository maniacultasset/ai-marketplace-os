# Build context is the repo root: apps/api/Dockerfile installs the uv workspace.
.git
.github
.gitignore
**/.venv
**/venv
**/__pycache__
**/*.py[cod]
**/.mypy_cache
**/.ruff_cache
**/.pytest_cache
**/.coverage
**/htmlcov
**/coverage

# secrets: nothing credential-bearing may be COPYable
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.p12
gcp-sa-*.json

# frontend build output (apps/web has its own Dockerfile)
**/node_modules
apps/web/.next
apps/web/out
apps/web/.turbo

# not needed at runtime
docs/
infra/
_archive/
**/tests/__snapshots__
**/*.log
**/*.sqlite3
**/.DS_Store
docker-compose.yml
README.md
ONBOARDING.md
