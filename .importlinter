# Import contracts (CANON-ADDENDUM.md §12, adapted by ADR-0013 §4: only packages that exist).
# Run: uv run lint-imports --config .importlinter
[importlinter]
root_packages =
    app
    app_mock
    mkos_schemas
    mkos_pipeline
include_external_packages = True

[importlinter:contract:schemas-never-imports-app]
name = mkos_schemas imports no app, web or DB framework
type = forbidden
source_modules =
    mkos_schemas
forbidden_modules =
    app
    sqlalchemy
    fastapi
    starlette
    psycopg

# Routers never import sqlalchemy or app.db (BACKEND-ARCHITECTURE.md:1273). Indirect chains are
# allowed: routers -> services -> app.db is the sanctioned route (BACKEND-ARCHITECTURE.md:1236).
[importlinter:contract:routers-never-import-the-db]
name = app.api never imports sqlalchemy or app.db directly
type = forbidden
source_modules =
    app.api
forbidden_modules =
    sqlalchemy
    app.db
allow_indirect_imports = True

# Engine-level SQL from a service would bypass the tenant guard; services reach the database
# through repositories. The readiness check is the one exemption. sqlalchemy.ext.asyncio is
# repo rule R3 in scripts/ci/check_repo_rules.py (import-linter forbids only package roots).
[importlinter:contract:services-never-import-the-engine]
name = app.services never imports app.db.session (except app.services.health)
type = forbidden
source_modules =
    app.services
forbidden_modules =
    app.db.session
ignore_imports =
    app.services.health -> app.db.session
allow_indirect_imports = True

[importlinter:contract:layers]
name = routers -> services -> repositories
type = layers
layers =
    app.api
    app.services
    app.repositories

# app.cli is an entry point (`python -m app.cli`): it imports the app, never the other way round.
[importlinter:contract:nothing-imports-the-cli]
name = nothing imports app.cli
type = forbidden
source_modules =
    app.api
    app.services
    app.repositories
    app.workers
    app.adapters
    app.core
    app.db
    app.main
forbidden_modules =
    app.cli

# The Pillow image checks are a pure library (S17a): no web, DB, worker, adapter or settings
# import, so the function stays deterministic and testable without infrastructure.
[importlinter:contract:image-checks-are-pure]
name = image checks are pure
type = forbidden
source_modules =
    app.services.image_checks
forbidden_modules =
    app.api
    app.db
    app.repositories
    app.workers
    app.adapters
    app.core
    sqlalchemy
    psycopg
    fastapi
    starlette
    pgvector
    alembic

# The local mock (S3 D5) is dev tooling: the app never imports it, and it reads only openapi.json.
[importlinter:contract:app-never-imports-mock]
name = app never imports app_mock
type = forbidden
source_modules =
    app
forbidden_modules =
    app_mock

[importlinter:contract:mock-imports-no-app]
name = app_mock imports no app, sqlalchemy or psycopg
type = forbidden
source_modules =
    app_mock
forbidden_modules =
    app
    sqlalchemy
    psycopg

# The Rules Engine is pure (invariant 2; CANON.md:126): no DB, web or app layers, directly or
# indirectly. The S14b port wraps it and does the loading.
[importlinter:contract:rules-engine-is-pure]
name = app.services.rules_engine is pure (no DB, web or app layers)
type = forbidden
source_modules =
    app.services.rules_engine
forbidden_modules =
    sqlalchemy
    psycopg
    fastapi
    starlette
    app.db
    app.repositories
    app.api
    app.workers
    app.adapters
    app.core
    app.cli

# The token decrypt path (invariant 6; EXECUTION-PLAN decision 15): the API encrypts only, and
# anything needing plaintext runs in an adapter or a worker job. Indirect imports count too, so
# no service or router can reach the unseal through a helper.
[importlinter:contract:decrypt-path-only-in-adapters-and-workers]
name = only app.adapters and app.workers import the decrypt path
type = forbidden
source_modules =
    app.api
    app.services
    app.repositories
    app.cli
    app.core
    app.db
    app.main
forbidden_modules =
    app.adapters.credentials

# The AI seam (CANON.md:125; S14b T2): the pipeline (the in-repo stub now, the tagged
# `mkos-pipeline` later) imports no app, web, DB or queue framework. Only installed packages can be
# named; the stub's AST allowlist test covers openai, langgraph and boto3 (S14b C3).
[importlinter:contract:pipeline-never-imports-app]
name = mkos_pipeline imports no app, web, DB or queue framework
type = forbidden
source_modules =
    mkos_pipeline
forbidden_modules =
    app
    sqlalchemy
    fastapi
    starlette
    psycopg
    procrastinate

# Only the generation worker calls `run_listing_pipeline` (CANON.md:104): no other layer imports it.
[importlinter:contract:only-workers-import-pipeline]
name = only app.workers imports mkos_pipeline
type = forbidden
source_modules =
    app.api
    app.services
    app.repositories
    app.adapters
    app.core
    app.db
    app.main
    app.cli
forbidden_modules =
    mkos_pipeline
