{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-status.sh\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Loading project status"
          }
        ]
      }
    ]
  }
}
