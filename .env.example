# The single env file (CANON.md naming register): `cp .env.example .env`.
# One key per docs/canon/ENV.md row, in register order, with its local value. Local dev values
# only: staging and production read Secret Manager, never a file in git.
# Settings uses extra="forbid", so an unknown key here aborts the boot.

# ---- App ----
APP_ENV=local
APP_ROLE=api
APP_NAME=marketplace-os-api
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=console
ALLOWED_ORIGINS=http://localhost:3000
REQUEST_MAX_BODY_BYTES=10485760
RATE_LIMIT_PER_TENANT_PER_MIN=120
RATE_LIMIT_PER_IP_PER_MIN=60
AUTH_LOGIN_RATE_LIMIT_PER_MIN=5
OAUTH_STATE_TTL_SECONDS=600
ADMIN_ENABLED=true
ADMIN_BASE_URL=/internal/admin
ADMIN_READ_ONLY=true
ADMIN_SESSION_SECRET=dev_only_admin_session_secret_at_least_32_chars
ADMIN_STAFF_EMAILS=
ADMIN_LOCAL_EMAIL=dev@local
PORT=8000

# ---- Database ----
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/marketplace_os
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/marketplace_os
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=15000

# ---- GCS ----
STORAGE_BACKEND=minio
GCS_BUCKET_IMAGES=marketplace-images
GCS_BUCKET_CSV=marketplace-csv
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ---- GCP ----
GCP_PROJECT_ID=
GCP_REGION=asia-south1
KMS_KEY_URI=
KMS_LOCAL_DEV_KEY=bG9jYWxfZGV2X29ubHlfMzJfYnl0ZV9rZXlfMDAwMDA=
SECRET_MANAGER_ENABLED=false
GIT_SHA=dev

# ---- JWT ----
JWT_SECRET=dev_only_change_me_at_least_32_characters_long
JWT_ALGORITHM=HS256
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=ai-marketplace-os
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_HASH_SCHEME=argon2id

# ---- LLM ----
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-REPLACE_ME
DEEPSEEK_API_KEY=
LLM_MODEL_DEFAULT=gpt-4o-mini
LLM_MODEL_ESCALATION=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CORRECTION_ATTEMPTS=3
LLM_DAILY_BUDGET_USD=12.00
LLM_TENANT_DAILY_BUDGET_USD=2.50

# ---- Amazon ----
AMAZON_APP_ID=
AMAZON_CLIENT_ID=amzn1.application-oa2-client.REPLACE_ME
AMAZON_CLIENT_SECRET=REPLACE_ME
AMAZON_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token
AMAZON_SPAPI_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
AMAZON_MARKETPLACE_ID=A21TJRUUN4KGV
AMAZON_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/marketplaces/amazon/callback
AMAZON_USE_SANDBOX=true

# ---- Flipkart ----
FLIPKART_CLIENT_ID=REPLACE_ME
FLIPKART_CLIENT_SECRET=REPLACE_ME
FLIPKART_TOKEN_URL=https://api.flipkart.net/oauth-service/oauth/token
FLIPKART_API_BASE=https://api.flipkart.net/sellers
FLIPKART_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/marketplaces/flipkart/callback

# ---- Observability ----
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_SERVICE_NAME=marketplace-os-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
ALERT_SLACK_WEBHOOK=
