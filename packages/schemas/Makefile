# Generated contract outputs (CANON.md:43-45): the JSON Schemas, the /api/v1 OpenAPI document and
# the TypeScript types. Every output is committed and never hand-edited; `make schemas-drift`
# regenerates them and fails on any diff. Needs no database, and no network once `ts-deps` has
# installed the pinned devDependencies from the lockfile (no on-demand downloads, ADR-0005 §5).
SHELL := bash
.SHELLFLAGS := -euo pipefail -c

# The fixed export env (CANON-ADDENDUM.md §13 as corrected by ADR-0004 §3; the CI values, CANON.md:21).
EXPORT_ENV := APP_ENV=local DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mos_test JWT_SECRET=ci_only_not_a_real_secret_at_least_32_chars
BIN := ./node_modules/.bin

.PHONY: all json openapi ts ts-deps ts-pack-check ts-consumer-check
all: json openapi ts

json:
	uv run --frozen python -m mkos_schemas.export --out jsonschema

openapi:
	$(EXPORT_ENV) uv run --frozen python -m app.openapi_export --out jsonschema/openapi.json

# The only step that needs the registry, and only when node_modules is missing.
ts-deps:
	@[ -d ts/node_modules ] || (cd ts && pnpm install --frozen-lockfile)

ts: ts-deps
	cd ts && $(BIN)/openapi-typescript ../jsonschema/openapi.json -o src/api.d.ts
	tmp="$$(mktemp -d)"; trap 'rm -rf "$$tmp"' EXIT; \
	  uv run --frozen python ../../scripts/schemas/bundle_contracts.py jsonschema "$$tmp/bundle.json"; \
	  cd ts && $(BIN)/json2ts -i "$$tmp/bundle.json" -o src/contracts.d.ts --unreachableDefinitions
	printf '%s\n' \
	  '// Generated by `make -C packages/schemas ts`; never hand-edit.' \
	  'export type * from "./api";' \
	  'export type * from "./contracts";' >ts/src/index.ts
	cd ts && $(BIN)/tsc -p tsconfig.json

# The tarball holds only package.json and the three generated files.
ts-pack-check: ts-deps
	cd ts && pnpm pack --dry-run --json | uv run --frozen python ../../../scripts/schemas/check_pack.py

# Install the packed tarball the way the FE does (alias @mkos/schemas) and type-check an import.
# Offline: it unpacks into a temp dir and uses this package's own tsc.
ts-consumer-check: ts-deps
	tmp="$$(mktemp -d)"; trap 'rm -rf "$$tmp"' EXIT; \
	  (cd ts && pnpm pack --pack-destination "$$tmp" >/dev/null); \
	  mkdir -p "$$tmp/app/node_modules/@mkos/schemas"; \
	  tar -xzf "$$tmp"/*.tgz -C "$$tmp/app/node_modules/@mkos/schemas" --strip-components=1; \
	  printf '%s\n' '{"compilerOptions": {"target": "ES2022", "module": "ESNext",' \
	    '"moduleResolution": "bundler", "strict": true, "noEmit": true, "skipLibCheck": false},' \
	    '"files": ["consumer.ts"]}' >"$$tmp/app/tsconfig.json"; \
	  printf '%s\n' 'import type { components, paths } from "@mkos/schemas";' \
	    'import type { ErrorReport } from "@mkos/schemas";' \
	    'type Envelope = components["schemas"]["ErrorEnvelope"];' \
	    'type Products = paths["/api/v1/products"]["get"]["responses"][200]["content"]["application/json"];' \
	    'export const code: Envelope["error"]["type"] = "NOT_FOUND";' \
	    'export const page = (p: Products): number => p.data.length;' \
	    'export const report = (r: ErrorReport): string => r.status;' >"$$tmp/app/consumer.ts"; \
	  ts/node_modules/.bin/tsc -p "$$tmp/app/tsconfig.json"; \
	  echo "ts-consumer-check: OK"
