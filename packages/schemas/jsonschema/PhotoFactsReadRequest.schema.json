{
  "$defs": {
    "ContextImage": {
      "description": "One product or label image the pipeline may look at (1.2.0).\n\nNot `ImageRef`: that type belongs to the publishable listing and refuses `packaging_label`, and\nthe label must still reach the extractor. Only base64 bytes for now; no URL field.",
      "properties": {
        "colourway_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Colourway Id"
        },
        "data_b64": {
          "title": "Data B64",
          "type": "string"
        },
        "height": {
          "maximum": 1024,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "image_id": {
          "format": "uuid",
          "title": "Image Id",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "back",
                "close_up"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "slot": {
          "$ref": "#/$defs/ImageSlot"
        },
        "width": {
          "maximum": 1024,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "image_id",
        "slot",
        "width",
        "height",
        "data_b64"
      ],
      "title": "ContextImage",
      "type": "object"
    },
    "ImageSlot": {
      "enum": [
        "main",
        "secondary",
        "lifestyle",
        "size_chart",
        "packaging_label"
      ],
      "title": "ImageSlot",
      "type": "string"
    },
    "PhotoTarget": {
      "description": "One product key the backend asks the vision step about (SI3).\n\n`fill`: no trusted value is stored, so a confident photo value may become an unconfirmed fact.\n`check`: a value is stored; a photo value can only raise a question.",
      "properties": {
        "allowed_values": {
          "items": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 40,
          "minItems": 1,
          "title": "Allowed Values",
          "type": "array"
        },
        "key": {
          "pattern": "^[a-z0-9_]{1,64}$",
          "title": "Key",
          "type": "string"
        },
        "min_confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Confidence",
          "type": "number"
        },
        "mode": {
          "enum": [
            "fill",
            "check"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "key",
        "mode",
        "allowed_values",
        "min_confidence"
      ],
      "title": "PhotoTarget",
      "type": "object"
    }
  },
  "$id": "https://schemas.mkos.internal/PhotoFactsReadRequest.schema.json",
  "description": "One read of a product's photos for the given keys.",
  "properties": {
    "attempt": {
      "default": 1,
      "maximum": 3,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "category": {
      "pattern": "^[a-z0-9_]{2,64}$",
      "title": "Category",
      "type": "string"
    },
    "images": {
      "items": {
        "$ref": "#/$defs/ContextImage"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Images",
      "type": "array"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "product_id": {
      "format": "uuid",
      "title": "Product Id",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "2.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "targets": {
      "items": {
        "$ref": "#/$defs/PhotoTarget"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Targets",
      "type": "array"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "product_id",
    "job_id",
    "request_id",
    "images",
    "targets",
    "category"
  ],
  "title": "PhotoFactsReadRequest",
  "type": "object"
}
