{
  "$defs": {
    "ColumnSample": {
      "properties": {
        "header": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Header",
          "type": "string"
        },
        "samples": {
          "items": {
            "maxLength": 200,
            "type": "string"
          },
          "maxItems": 5,
          "title": "Samples",
          "type": "array"
        }
      },
      "required": [
        "header"
      ],
      "title": "ColumnSample",
      "type": "object"
    },
    "DictionaryEntry": {
      "properties": {
        "aliases": {
          "items": {
            "maxLength": 200,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Aliases",
          "type": "array"
        },
        "allowed_values": {
          "anyOf": [
            {
              "items": {
                "maxLength": 200,
                "type": "string"
              },
              "maxItems": 40,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Values"
        },
        "key": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "value_type": {
          "default": "text",
          "enum": [
            "text",
            "enum",
            "number",
            "measure",
            "boolean",
            "list"
          ],
          "title": "Value Type",
          "type": "string"
        }
      },
      "required": [
        "key"
      ],
      "title": "DictionaryEntry",
      "type": "object"
    }
  },
  "$id": "https://schemas.mkos.internal/ColumnMapRequest.schema.json",
  "properties": {
    "dictionary": {
      "items": {
        "$ref": "#/$defs/DictionaryEntry"
      },
      "maxItems": 120,
      "minItems": 1,
      "title": "Dictionary",
      "type": "array"
    },
    "headers": {
      "items": {
        "$ref": "#/$defs/ColumnSample"
      },
      "maxItems": 60,
      "minItems": 1,
      "title": "Headers",
      "type": "array"
    },
    "job_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Job Id"
    },
    "product_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Product Id"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "2.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "taken_keys": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "type": "string"
      },
      "maxItems": 120,
      "title": "Taken Keys",
      "type": "array"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "request_id",
    "headers",
    "dictionary"
  ],
  "title": "ColumnMapRequest",
  "type": "object"
}
