{
  "$defs": {
    "ContextImage": {
      "description": "One product or label image the pipeline may look at (1.2.0).\n\nNot `ImageRef`: that type belongs to the publishable listing and refuses `packaging_label`, and\nthe label must still reach the extractor. Only base64 bytes for now; no URL field.",
      "properties": {
        "colourway_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Colourway Id"
        },
        "data_b64": {
          "title": "Data B64",
          "type": "string"
        },
        "height": {
          "maximum": 1024,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "image_id": {
          "format": "uuid",
          "title": "Image Id",
          "type": "string"
        },
        "slot": {
          "$ref": "#/$defs/ImageSlot"
        },
        "width": {
          "maximum": 1024,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "image_id",
        "slot",
        "width",
        "height",
        "data_b64"
      ],
      "title": "ContextImage",
      "type": "object"
    },
    "ImageSlot": {
      "enum": [
        "main",
        "secondary",
        "lifestyle",
        "size_chart",
        "packaging_label"
      ],
      "title": "ImageSlot",
      "type": "string"
    }
  },
  "$id": "https://schemas.mkos.internal/ImageEditRequest.schema.json",
  "description": "One edit of one product photo. The image is the backend's square JPEG (at most 1024 px).",
  "properties": {
    "attempt": {
      "default": 1,
      "maximum": 3,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "category": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Category",
      "type": "string"
    },
    "image": {
      "$ref": "#/$defs/ContextImage"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "product_id": {
      "format": "uuid",
      "title": "Product Id",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "2.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task": {
      "const": "white_background",
      "title": "Task",
      "type": "string"
    },
    "tenant_id": {
      "format": "uuid",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "product_id",
    "job_id",
    "request_id",
    "task",
    "image",
    "category"
  ],
  "title": "ImageEditRequest",
  "type": "object"
}
