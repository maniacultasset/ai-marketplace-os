  "$id": "https://schemas.mkos.internal/RuleSet.schema.json",
  "description": "Carried on GenerationContext.marketplace_rules; the backend resolves it before enqueue.\nPipelineDeps has NO load_rules port \u2014 the AI package fetches nothing. Rows group by\n(tenant_id, field, rule_type, subject, pack); a category rule shadows the category=NULL\nrule and the highest enabled version wins. Tenant rules never shadow platform rules: both\nrun, so brand rules only tighten.",
  "properties": {
    "category": {
      "pattern": "^[a-z0-9_]{2,64}$",
      "title": "Category",
      "type": "string"
    },
    "loaded_at": {
      "format": "date-time",
      "title": "Loaded At",
      "type": "string"
    },
    "marketplace": {
      "$ref": "#/$defs/Marketplace"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/Rule"
      },
      "maxItems": 500,
      "title": "Rules",
      "type": "array"
    },
    "rules_version": {
      "default": 0,
      "minimum": 0,
      "title": "Rules Version",
      "type": "integer"
    }
  },
  "required": [
    "marketplace",
    "category",
    "loaded_at"
  ],
  "title": "RuleSet",
  "type": "object"
}
