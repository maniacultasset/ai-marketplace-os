{
  "$defs": {
    "ErrorClass": {
      "enum": [
        "missing_data",
        "invalid_value",
        "category_mismatch",
        "variation_error",
        "media_error",
        "content_error",
        "identifier_error",
        "compliance_error",
        "account_permission",
        "marketplace_technical",
        "unknown"
      ],
      "title": "ErrorClass",
      "type": "string"
    },
    "ErrorCode": {
      "description": "Every machine-readable error code in v1.0.0.",
      "enum": [
        "ACCOUNT_PERMISSION_DENIED",
        "API_REJECTED_PARTIAL",
        "AI_CREDIT_EXHAUSTED",
        "AI_PROVIDER_KEY_INVALID",
        "AUTH_EXPIRED",
        "BANNED_TERM",
        "BATCH_TOO_LARGE",
        "BUDGET_EXCEEDED",
        "BULK_APPROVE_REQUIRES_VALIDATED",
        "BYTE_BUDGET_EXCEEDED",
        "CATEGORY_MISMATCH",
        "CATEGORY_NOT_MAPPED",
        "COMPLIANCE_DECLARATION_MISSING",
        "CRITICAL_FACT_MISSING",
        "CROSS_FIELD_MISMATCH",
        "DUPLICATE_SKU_IN_FILE",
        "DUPLICATE_SUBMISSION_BLOCKED",
        "FACTS_CHANGED_SINCE_APPROVAL",
        "FACT_LEVEL_INVALID",
        "FACT_MISMATCH",
        "FACT_NEEDS_CONFIRMATION",
        "FACT_SOURCE_FORBIDDEN",
        "FIELD_TOO_LONG",
        "FIELD_TOO_SHORT",
        "GENERATION_FAILED",
        "HEADER_DUPLICATE_COLUMN",
        "HEADER_MISSING_COLUMN",
        "HEADER_UNKNOWN_COLUMN",
        "IDENTIFIER_DUPLICATE",
        "IDENTIFIER_INVALID",
        "IDENTIFIER_MISSING",
        "IMAGE_NON_COMPLIANT",
        "IMPORT_FAILED",
        "IDEMPOTENCY_KEY_REUSED",
        "INTERNAL_ERROR",
        "INVALID_STATUS_TRANSITION",
        "JOB_TIMEOUT",
        "JSON_INVALID",
        "KEYWORD_DUPLICATE",
        "LAST_OWNER_REQUIRED",
        "LISTING_ARCHIVED",
        "LISTING_BUSY",
        "LISTING_PAUSED",
        "MAKER_CHECKER_VIOLATION",
        "MARKETPLACE_UNAVAILABLE",
        "MARKETPLACE_UNCONFIRMED",
        "MARKETPLACE_UNKNOWN_ERROR",
        "MARKETPLACE_ACCOUNT_CONFLICT",
        "METHOD_NOT_ALLOWED",
        "MISSING_ATTRIBUTE",
        "MFA_ENROLLMENT_REQUIRED",
        "MFA_STEP_UP_REQUIRED",
        "MODEL_UNAVAILABLE",
        "NOT_FOUND",
        "NOT_IMPLEMENTED",
        "OAUTH_STATE_INVALID",
        "PAYLOAD_TOO_LARGE",
        "PERMISSION_DENIED",
        "PATTERN_MISMATCH",
        "PRICE_ABOVE_MRP",
        "PUBLISH_FAILED",
        "RATE_LIMITED",
        "REQUIRED_FIELD_MISSING",
        "RETRY_EXHAUSTED",
        "SCHEMA_INVALID",
        "SELLER_SKU_CONFLICT",
        "SKU_CONFLICT",
        "STALE_VERSION",
        "SUBMISSION_ATTEMPTS_EXHAUSTED",
        "SUBMISSION_IN_FLIGHT",
        "SUBMISSION_NOT_APPLIED",
        "TENANT_SUSPENDED",
        "TIMEOUT",
        "TOKEN_LIMIT",
        "UNAUTHENTICATED",
        "UNKNOWN_FACT_KEY",
        "UNSUPPORTED_CLAIM",
        "VALIDATION_FAILED",
        "VALUE_NOT_ALLOWED",
        "VARIANT_MATRIX_INCOMPLETE",
        "VARIATION_INVALID"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorItem": {
      "properties": {
        "auto_fixable": {
          "default": false,
          "title": "Auto Fixable",
          "type": "boolean"
        },
        "error_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error_code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "fix_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Gate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "marketplace": {
          "anyOf": [
            {
              "$ref": "#/$defs/Marketplace"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "raw_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Code"
        },
        "retry_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetryClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "rule_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "error"
        },
        "source": {
          "$ref": "#/$defs/ErrorSource"
        },
        "suggestion": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestion"
        },
        "value_submitted": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Submitted"
        }
      },
      "required": [
        "field",
        "error_code",
        "message",
        "source",
        "retryable"
      ],
      "title": "ErrorItem",
      "type": "object"
    },
    "ErrorReport": {
      "properties": {
        "attempts_used": {
          "default": 0,
          "maximum": 3,
          "minimum": 0,
          "title": "Attempts Used",
          "type": "integer"
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorItem"
          },
          "maxItems": 500,
          "title": "Errors",
          "type": "array"
        },
        "listing_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Listing Id"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "request_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "schema_version": {
          "default": "2.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "partial"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "ErrorReport",
      "type": "object"
    },
    "ErrorSource": {
      "enum": [
        "schema",
        "rules_engine",
        "vision_model",
        "ai_model",
        "amazon_adapter",
        "flipkart_adapter",
        "system"
      ],
      "title": "ErrorSource",
      "type": "string"
    },
    "FixAction": {
      "enum": [
        "remap_value",
        "reformat",
        "derive_field",
        "rebuild_variation"
      ],
      "title": "FixAction",
      "type": "string"
    },
    "Gate": {
      "description": "The nine quality gates before submission (spec L1388-1424); schemas 1.2.0.",
      "enum": [
        "identity",
        "classification",
        "attributes",
        "variants",
        "media",
        "content",
        "compliance",
        "commercial",
        "submission"
      ],
      "title": "Gate",
      "type": "string"
    },
    "ImportPhotoTotals": {
      "description": "G2: the photo links of one import, by outcome (`total` = waiting + saved + failed +\nskipped).",
      "properties": {
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "retryable": {
          "default": 0,
          "description": "Links a retry (`POST /imports/{import_id}/photo-links/retry`) would download again: the failed ones and the per-file cap skips.",
          "minimum": 0,
          "title": "Retryable",
          "type": "integer"
        },
        "saved": {
          "minimum": 0,
          "title": "Saved",
          "type": "integer"
        },
        "skipped": {
          "default": 0,
          "description": "Links not downloaded: the per-file cap, a photo the seller removed, a deleted product.",
          "minimum": 0,
          "title": "Skipped",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        },
        "waiting": {
          "minimum": 0,
          "title": "Waiting",
          "type": "integer"
        }
      },
      "required": [
        "total",
        "waiting",
        "saved",
        "failed"
      ],
      "title": "ImportPhotoTotals",
      "type": "object"
    },
    "ImportRowResult": {
      "properties": {
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorItem"
          },
          "title": "Errors",
          "type": "array"
        },
        "photos": {
          "description": "G2: this row's photo links and what became of each (empty while the photo download is switched off, and for a row whose links another row of the file already named).",
          "items": {
            "$ref": "#/$defs/PhotoLinkResult"
          },
          "maxItems": 9,
          "title": "Photos",
          "type": "array"
        },
        "product_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Id"
        },
        "row_number": {
          "minimum": 2,
          "title": "Row Number",
          "type": "integer"
        },
        "sku": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sku"
        },
        "status": {
          "enum": [
            "imported",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "row_number",
        "status"
      ],
      "title": "ImportRowResult",
      "type": "object"
    },
    "Marketplace": {
      "enum": [
        "amazon",
        "flipkart"
      ],
      "title": "Marketplace",
      "type": "string"
    },
    "PhotoLinkResult": {
      "description": "G2: one photo link from a spreadsheet row and what became of it. The link itself is never\nreturned (it may carry a signed token): `position` and `column` say which cell it was.",
      "properties": {
        "colourway_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The colour the photo belongs to on a style split by colour.",
          "title": "Colourway Id"
        },
        "column": {
          "enum": [
            "main_image",
            "additional_images"
          ],
          "title": "Column",
          "type": "string"
        },
        "http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        },
        "image_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Id"
        },
        "link_id": {
          "format": "uuid",
          "title": "Link Id",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The seller sentence for a failed or skipped link (prefix it with Photo N).",
          "title": "Message"
        },
        "position": {
          "description": "Which link of the row this is (1 = the first link), for 'Photo N'.",
          "maximum": 9,
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "problem": {
          "anyOf": [
            {
              "enum": [
                "not_found",
                "not_public",
                "not_image",
                "unsupported_type",
                "too_large",
                "too_many_pixels",
                "corrupt",
                "timeout",
                "unreachable",
                "blocked_address",
                "too_many_redirects",
                "server_error",
                "photo_limit",
                "import_cap",
                "removed_by_seller",
                "product_gone"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Problem"
        },
        "retryable": {
          "default": false,
          "description": "A retry (`POST .../photo-links/retry`) would download this link again.",
          "title": "Retryable",
          "type": "boolean"
        },
        "status": {
          "description": "`queued` waits to download; `downloading`; `saved` became a product photo (`image_id`, `view`); `failed` could not be used (`problem`, `message`); `skipped` was not downloaded (`problem`: the per-file cap, a photo the seller removed, or a deleted product).",
          "enum": [
            "queued",
            "downloading",
            "saved",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "view": {
          "anyOf": [
            {
              "enum": [
                "front",
                "back",
                "close_up",
                "lifestyle",
                "size_chart",
                "packaging_label",
                "extra"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The view the saved photo holds now (`extra` for a plain additional photo); null until saved, and when the saved photo was removed.",
          "title": "View"
        }
      },
      "required": [
        "link_id",
        "position",
        "column",
        "status"
      ],
      "title": "PhotoLinkResult",
      "type": "object"
    },
    "RetryClass": {
      "enum": [
        "auto_retry",
        "ai_correct",
        "user_action",
        "system_failure"
      ],
      "title": "RetryClass",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "error",
        "warning"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "$id": "https://schemas.mkos.internal/ImportReport.schema.json",
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "failed": {
      "minimum": 0,
      "title": "Failed",
      "type": "integer"
    },
    "import_id": {
      "format": "uuid",
      "title": "Import Id",
      "type": "string"
    },
    "imported": {
      "minimum": 0,
      "title": "Imported",
      "type": "integer"
    },
    "photos": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImportPhotoTotals"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "G2: the file's photo links by outcome; null when the import named none."
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/ImportRowResult"
      },
      "maxItems": 10000,
      "title": "Rows",
      "type": "array"
    },
    "schema_version": {
      "default": "2.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "total_rows": {
      "minimum": 0,
      "title": "Total Rows",
      "type": "integer"
    }
  },
  "required": [
    "import_id",
    "total_rows",
    "imported",
    "failed"
  ],
  "title": "ImportReport",
  "type": "object"
}
