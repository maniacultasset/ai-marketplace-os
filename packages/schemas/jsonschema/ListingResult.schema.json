{
  "$defs": {
    "ErrorClass": {
      "enum": [
        "missing_data",
        "invalid_value",
        "category_mismatch",
        "variation_error",
        "media_error",
        "content_error",
        "identifier_error",
        "compliance_error",
        "account_permission",
        "marketplace_technical",
        "unknown"
      ],
      "title": "ErrorClass",
      "type": "string"
    },
    "ErrorCode": {
      "description": "Every machine-readable error code in v1.0.0.",
      "enum": [
        "ACCOUNT_PERMISSION_DENIED",
        "API_REJECTED_PARTIAL",
        "AUTH_EXPIRED",
        "BANNED_TERM",
        "BATCH_TOO_LARGE",
        "BUDGET_EXCEEDED",
        "BULK_APPROVE_REQUIRES_VALIDATED",
        "BYTE_BUDGET_EXCEEDED",
        "CATEGORY_MISMATCH",
        "CATEGORY_NOT_MAPPED",
        "COMPLIANCE_DECLARATION_MISSING",
        "CRITICAL_FACT_MISSING",
        "CROSS_FIELD_MISMATCH",
        "DUPLICATE_SKU_IN_FILE",
        "DUPLICATE_SUBMISSION_BLOCKED",
        "FACTS_CHANGED_SINCE_APPROVAL",
        "FACT_LEVEL_INVALID",
        "FACT_MISMATCH",
        "FACT_NEEDS_CONFIRMATION",
        "FACT_SOURCE_FORBIDDEN",
        "FIELD_TOO_LONG",
        "FIELD_TOO_SHORT",
        "GENERATION_FAILED",
        "HEADER_DUPLICATE_COLUMN",
        "HEADER_MISSING_COLUMN",
        "HEADER_UNKNOWN_COLUMN",
        "IDENTIFIER_DUPLICATE",
        "IDENTIFIER_INVALID",
        "IDENTIFIER_MISSING",
        "IMAGE_NON_COMPLIANT",
        "IMPORT_FAILED",
        "IDEMPOTENCY_KEY_REUSED",
        "INTERNAL_ERROR",
        "INVALID_STATUS_TRANSITION",
        "JOB_TIMEOUT",
        "JSON_INVALID",
        "KEYWORD_DUPLICATE",
        "LAST_OWNER_REQUIRED",
        "LISTING_ARCHIVED",
        "LISTING_BUSY",
        "LISTING_PAUSED",
        "MAKER_CHECKER_VIOLATION",
        "MARKETPLACE_UNAVAILABLE",
        "MARKETPLACE_UNCONFIRMED",
        "MARKETPLACE_UNKNOWN_ERROR",
        "MARKETPLACE_ACCOUNT_CONFLICT",
        "METHOD_NOT_ALLOWED",
        "MISSING_ATTRIBUTE",
        "MFA_ENROLLMENT_REQUIRED",
        "MFA_STEP_UP_REQUIRED",
        "MODEL_UNAVAILABLE",
        "NOT_FOUND",
        "NOT_IMPLEMENTED",
        "OAUTH_STATE_INVALID",
        "PAYLOAD_TOO_LARGE",
        "PERMISSION_DENIED",
        "PATTERN_MISMATCH",
        "PRICE_ABOVE_MRP",
        "PUBLISH_FAILED",
        "RATE_LIMITED",
        "REQUIRED_FIELD_MISSING",
        "RETRY_EXHAUSTED",
        "SCHEMA_INVALID",
        "SELLER_SKU_CONFLICT",
        "SKU_CONFLICT",
        "STALE_VERSION",
        "SUBMISSION_ATTEMPTS_EXHAUSTED",
        "SUBMISSION_IN_FLIGHT",
        "SUBMISSION_NOT_APPLIED",
        "TIMEOUT",
        "TOKEN_LIMIT",
        "UNAUTHENTICATED",
        "UNKNOWN_FACT_KEY",
        "UNSUPPORTED_CLAIM",
        "VALIDATION_FAILED",
        "VALUE_NOT_ALLOWED",
        "VARIANT_MATRIX_INCOMPLETE",
        "VARIATION_INVALID"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorItem": {
      "properties": {
        "auto_fixable": {
          "default": false,
          "title": "Auto Fixable",
          "type": "boolean"
        },
        "error_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error_code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "fix_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Gate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "marketplace": {
          "anyOf": [
            {
              "$ref": "#/$defs/Marketplace"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "raw_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Code"
        },
        "retry_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetryClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "rule_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "error"
        },
        "source": {
          "$ref": "#/$defs/ErrorSource"
        },
        "suggestion": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestion"
        },
        "value_submitted": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Submitted"
        }
      },
      "required": [
        "field",
        "error_code",
        "message",
        "source",
        "retryable"
      ],
      "title": "ErrorItem",
      "type": "object"
    },
    "ErrorReport": {
      "properties": {
        "attempts_used": {
          "default": 0,
          "maximum": 3,
          "minimum": 0,
          "title": "Attempts Used",
          "type": "integer"
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorItem"
          },
          "maxItems": 500,
          "title": "Errors",
          "type": "array"
        },
        "listing_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Listing Id"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "request_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "schema_version": {
          "default": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "partial"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "ErrorReport",
      "type": "object"
    },
    "ErrorSource": {
      "enum": [
        "schema",
        "rules_engine",
        "vision_model",
        "ai_model",
        "amazon_adapter",
        "flipkart_adapter",
        "system"
      ],
      "title": "ErrorSource",
      "type": "string"
    },
    "FieldResult": {
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorItem"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "field",
        "status"
      ],
      "title": "FieldResult",
      "type": "object"
    },
    "FixAction": {
      "enum": [
        "remap_value",
        "reformat",
        "derive_field",
        "rebuild_variation"
      ],
      "title": "FixAction",
      "type": "string"
    },
    "Gate": {
      "description": "The nine quality gates before submission (spec L1388-1424); schemas 1.2.0.",
      "enum": [
        "identity",
        "classification",
        "attributes",
        "variants",
        "media",
        "content",
        "compliance",
        "commercial",
        "submission"
      ],
      "title": "Gate",
      "type": "string"
    },
    "ItemMarketplaceState": {
      "enum": [
        "not_submitted",
        "processing",
        "pending_review",
        "live",
        "inactive",
        "rejected",
        "removed"
      ],
      "title": "ItemMarketplaceState",
      "type": "string"
    },
    "ItemResult": {
      "properties": {
        "external_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/FieldResult"
          },
          "title": "Fields",
          "type": "array"
        },
        "live_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Live Url"
        },
        "marketplace_state": {
          "$ref": "#/$defs/ItemMarketplaceState"
        },
        "product_id": {
          "format": "uuid",
          "title": "Product Id",
          "type": "string"
        },
        "seller_sku": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Seller Sku",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "seller_sku",
        "marketplace_state"
      ],
      "title": "ItemResult",
      "type": "object"
    },
    "Marketplace": {
      "enum": [
        "amazon",
        "flipkart"
      ],
      "title": "Marketplace",
      "type": "string"
    },
    "MarketplaceState": {
      "enum": [
        "not_submitted",
        "processing",
        "pending_review",
        "live",
        "partially_live",
        "inactive",
        "rejected",
        "removed"
      ],
      "title": "MarketplaceState",
      "type": "string"
    },
    "RetryClass": {
      "enum": [
        "auto_retry",
        "ai_correct",
        "user_action",
        "system_failure"
      ],
      "title": "RetryClass",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "error",
        "warning"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "$id": "https://schemas.mkos.internal/ListingResult.schema.json",
  "properties": {
    "attempt": {
      "default": 1,
      "maximum": 3,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "external_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Id"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/FieldResult"
      },
      "title": "Fields",
      "type": "array"
    },
    "idempotency_key": {
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ItemResult"
      },
      "title": "Items",
      "type": "array"
    },
    "listing_id": {
      "format": "uuid",
      "title": "Listing Id",
      "type": "string"
    },
    "marketplace": {
      "$ref": "#/$defs/Marketplace"
    },
    "marketplace_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/MarketplaceState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "raw_response_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Response Digest"
    },
    "schema_version": {
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "published",
        "partially_published",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "submission_ref": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submission Ref"
    }
  },
  "required": [
    "listing_id",
    "marketplace",
    "status",
    "idempotency_key"
  ],
  "title": "ListingResult",
  "type": "object"
}
