{
  "$defs": {
    "Claim": {
      "description": "A factual statement kept in the listing text, and the product facts behind it (1.2.0).",
      "properties": {
        "fact_keys": {
          "items": {
            "type": "string"
          },
          "title": "Fact Keys",
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "supported",
            "unsupported",
            "removed"
          ],
          "title": "Status",
          "type": "string"
        },
        "text_path": {
          "title": "Text Path",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text_path",
        "fact_keys",
        "status"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ImageRef": {
      "properties": {
        "image_id": {
          "format": "uuid",
          "title": "Image Id",
          "type": "string"
        },
        "position": {
          "default": 0,
          "maximum": 99,
          "minimum": 0,
          "title": "Position",
          "type": "integer"
        },
        "slot": {
          "$ref": "#/$defs/ImageSlot"
        }
      },
      "required": [
        "image_id",
        "slot"
      ],
      "title": "ImageRef",
      "type": "object"
    },
    "ImageSlot": {
      "enum": [
        "main",
        "secondary",
        "lifestyle",
        "size_chart",
        "packaging_label"
      ],
      "title": "ImageSlot",
      "type": "string"
    },
    "ListingContent": {
      "properties": {
        "bullets": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Bullets",
          "type": "array"
        },
        "description": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "bullets",
        "description"
      ],
      "title": "ListingContent",
      "type": "object"
    },
    "ListingKeywords": {
      "properties": {
        "hidden_terms": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Hidden Terms",
          "type": "array"
        },
        "search_terms": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Search Terms",
          "type": "array"
        }
      },
      "title": "ListingKeywords",
      "type": "object"
    },
    "ListingStatus": {
      "enum": [
        "created",
        "generating",
        "validated",
        "needs_review",
        "approved",
        "publishing",
        "published",
        "blocked",
        "failed"
      ],
      "title": "ListingStatus",
      "type": "string"
    },
    "Marketplace": {
      "enum": [
        "amazon",
        "flipkart"
      ],
      "title": "Marketplace",
      "type": "string"
    }
  },
  "$id": "https://schemas.mkos.internal/CanonicalListing.schema.json",
  "properties": {
    "attribute_sources": {
      "maxProperties": 128,
      "patternProperties": {
        "^[a-z0-9_]{1,64}$": {
          "maxLength": 192,
          "minLength": 1,
          "type": "string"
        }
      },
      "title": "Attribute Sources",
      "type": "object"
    },
    "attributes": {
      "patternProperties": {
        "^[a-z0-9_]{1,64}$": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ]
        }
      },
      "title": "Attributes",
      "type": "object"
    },
    "category": {
      "pattern": "^[a-z0-9_]{2,64}$",
      "title": "Category",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "maxItems": 64,
      "title": "Claims",
      "type": "array"
    },
    "confidence_score": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence Score"
    },
    "content": {
      "$ref": "#/$defs/ListingContent"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "generated_by_agent_run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generated By Agent Run Id"
    },
    "images": {
      "items": {
        "$ref": "#/$defs/ImageRef"
      },
      "title": "Images",
      "type": "array"
    },
    "keywords": {
      "$ref": "#/$defs/ListingKeywords"
    },
    "listing_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Listing Id"
    },
    "locale": {
      "const": "en-IN",
      "default": "en-IN",
      "title": "Locale",
      "type": "string"
    },
    "marketplace": {
      "$ref": "#/$defs/Marketplace"
    },
    "product_id": {
      "format": "uuid",
      "title": "Product Id",
      "type": "string"
    },
    "schema_version": {
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ListingStatus",
      "default": "created"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "product_id",
    "marketplace",
    "category",
    "content"
  ],
  "title": "CanonicalListing",
  "type": "object"
}
