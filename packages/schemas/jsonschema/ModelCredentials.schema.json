{
  "$id": "https://schemas.mkos.internal/ModelCredentials.schema.json",
  "additionalProperties": false,
  "properties": {
    "api_base": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Api Base"
    },
    "api_key": {
      "format": "password",
      "title": "Api Key",
      "type": "string",
      "writeOnly": true
    },
    "model": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "provider": {
      "enum": [
        "openai",
        "deepseek"
      ],
      "title": "Provider",
      "type": "string"
    },
    "timeout_seconds": {
      "default": 60.0,
      "exclusiveMinimum": 0,
      "maximum": 600,
      "title": "Timeout Seconds",
      "type": "number"
    }
  },
  "required": [
    "provider",
    "api_key",
    "model"
  ],
  "title": "ModelCredentials",
  "type": "object"
}
