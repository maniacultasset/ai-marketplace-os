# Build context is the repo root: apps/api/Dockerfile installs the uv workspace.
.git
.github
.gitignore
**/.venv
**/venv
**/__pycache__
**/*.py[cod]
**/.mypy_cache
**/.ruff_cache
**/.pytest_cache
**/.hypothesis
**/.import_linter_cache
**/.coverage
**/htmlcov
**/coverage
**/mutants

# secrets: nothing credential-bearing may be COPYable, at any depth
**/.env
**/.env.*
!**/.env.example
**/secrets/
**/*.pem
**/*.key
**/*.p12
**/gcp-sa-*.json

**/node_modules

# not needed at runtime
apps/api/app_mock/
apps/api/tests/
docs/
deliverables/
scaffold/
scripts/docgen/
scripts/trace/
.tools/
infra/
_archive/
**/tests/__snapshots__
**/*.log
**/*.sqlite3
**/.DS_Store
docker-compose.yml
README.md
ONBOARDING.md
