# scripts/deploy/gcp/prod.env: the NON-secret settings `deploy.sh prod` reads (ADR-0001 sizes;
# names from docs/EXECUTION-PLAN.md §5.2 and docs/canon/ENV.md). Plain KEY=value lines, sourced by
# bash. Never put a secret here: secrets live only in Secret Manager (`deploy.sh prod setup`).
PROJECT=aimos-prod
REGION=asia-south1
APP_ENV=production

# ---- FILL IN before `deploy` (the api refuses http, loopback or `*` origins outside local) ----
# Exact https browser origins of the dashboard, comma-separated, no trailing `/`.
ALLOWED_ORIGINS=https://www.kuinn.in,https://kuinn.in,https://kuinn-web.vercel.app,https://ai-marketplace-os-web.vercel.app
# The dashboard's https origin the OAuth callback redirects to (scheme and host only).
DASHBOARD_BASE_URL=https://www.kuinn.in
# Optional: the API's public https origin once a domain fronts it (api.<domain>). Blank: the Cloud
# Run service URL, which JWT_ISSUER and the OAuth redirect URIs then use.
API_PUBLIC_URL=https://api.kuinn.in

# ---- images and runtime names ----
AR_REPO=aimos
IMAGE_NAME=backend
API_SERVICE=aimos-api
WORKER_POOL=aimos-worker
MIGRATE_JOB=aimos-migrate
DB_INIT_JOB=aimos-db-init
OPS_JOB=aimos-ops
# DPP 1.7: the daily maintenance job (retention and the marketplace account purge).
MAINT_JOB=aimos-maintenance

# ---- service accounts (names before @<project>.iam.gserviceaccount.com) ----
SA_API=aimos-api
SA_WORKER=aimos-worker
SA_MIGRATE=aimos-migrate
SA_OPS=aimos-ops
SA_STORAGE=aimos-storage
SA_BUILD=aimos-build
SA_MAINT=aimos-maint
SA_SCHED=aimos-sched

# ---- Cloud SQL (PostgreSQL 17, Enterprise edition, zonal; ADR-0001) ----
SQL_INSTANCE=aimos-db
SQL_TIER=db-custom-1-3840
SQL_STORAGE_GB=30
# ADR-0001 connection ledger: 78 of 100.
SQL_MAX_CONNECTIONS=100
SQL_PITR_DAYS=7
SQL_DELETION_PROTECTION=true
# DPP 2.7.4: where the automated backups live. The instance's region until the client agrees a
# second region (asia-south2, Delhi, keeps the data in India); `setup` then moves new backups there.
SQL_BACKUP_LOCATION=asia-south1
DB_NAME=marketplace_os

# ---- storage, keys, build ----
BUCKET_IMAGES=aimos-images-prod
BUCKET_CSV=aimos-csv-prod
BUCKET_SUBMISSIONS=aimos-submissions-prod
# Public listing images (SI1, ADR-0026): stable links marketplaces fetch. The bucket allows anonymous
# object GET only (legacyObjectReader, no list); images.kuinn.in is the Cloudflare Worker in
# scripts/deploy/cloudflare/images-edge-worker.js. Provisioned by the owner 2026-11-07.
GCS_BUCKET_IMAGES_PUBLIC=aimos-images-public-prod
IMAGE_PUBLIC_BASE_URL=https://images.kuinn.in
BUILD_BUCKET=aimos-prod-build-src
CSV_RETENTION_DAYS=30
KMS_KEYRING=marketplace-os
KMS_KEY=oauth-token-key
# DPP-1 (ADR-0021): the MFA secrets' own key on the same ring (api only).
KMS_MFA_KEY=mfa-secret-key
LOG_RETENTION_DAYS=30

# ---- sizes (ADR-0001: prod api min 1 / max 3; worker 1 instance) ----
API_CPU=1
API_MEMORY=1Gi
API_MIN_INSTANCES=1
API_MAX_INSTANCES=3
# One uvicorn process with a pool of 5 + 5 connections (ENV.md DATABASE_POOL_SIZE).
API_CONCURRENCY=40
# On since the AI team's pipeline is pinned (PIPELINE_REF below). A production worker refuses
# mkos-pipeline-stub at boot (app/core/config.py), so deploy.sh refuses WORKER_ENABLED=true here
# without PIPELINE_REF (ADR-0024). A stopped worker is an incident (docs/runbooks/INCIDENTS.md).
WORKER_ENABLED=true
# V1 hardening #9 (2026-11-09): sized for about 10 brands onboarding at once. 2 vCPU and 4 GiB run
# two image check children side by side (each may map up to 1 GiB; deploy.sh refuses less than
# IMAGE_CHECK_CONCURRENCY + 1 GiB or under 2 vCPU for more than one), about 2x the photo throughput
# of 1 vCPU / 2 GiB with one child. Still one always-on instance, so the worker's compute bill
# doubles (twice the vCPU and memory seconds); a third child or a second instance waits for real
# load. Rollback: WORKER_CPU=1, WORKER_MEMORY=2Gi and IMAGE_CHECK_CONCURRENCY blank (1).
WORKER_CPU=2
WORKER_MEMORY=4Gi
WORKER_INSTANCES=1
IMAGE_CHECK_CONCURRENCY=2

# ---- AI pipeline and model gateway (ADR-0024; docs/runbooks/DEPLOY-GCP.md) ----
# Blank: the image carries the in-repo stub (a production worker refuses it). A full 40-character
# mkos-pipeline commit sha: `build` installs that commit instead, fetched with the read-only deploy
# key MKOS_PIPELINE_DEPLOY_KEY (Secret Manager, build account only; `setup` creates the secret and
# prints how to add the key).
# mkos-pipeline v0.6.0 (size_chart_read/v4: an unverified unit comes back unknown and the seller picks it; live gpt-4o G-size met all bars, exact 0.9, 0 invented), pinned 2026-11-09. Rollback: v0.5.0 = f631923204f4ed9b4d617965c5c83e5cc347a75b (with SIZE_CHART_READ_ENABLED=false); v0.4.3 = e6a583b3509e68e305eb85e3e4ce6fc9f8f7accd (only together with LLM_MODEL_VISION blank).
# mkos-pipeline v0.7.0 (V1.1 understanding: classify, map_columns, LLM claim check, photo_qa, Flipkart tuning; live G-gen, G-photo, G-size, G-classify, G-columns, G-claims, G-photoqa bars met on the synthetic sets), pinned 2026-11-09. Rollback: v0.6.0 = bf4fbb8afa2562a0bf886f8038bd8813016a9084 (with the three V1.1 switches below false).
PIPELINE_REF=290340f248f828a940186da6efcd9f031fb741f7
# The model gateway: openrouter sends every worker model call (generation, vision, embedding) to
# OpenRouter with one key, OPENROUTER_API_KEY; the URL is fixed in code. The AI team picks the
# provider and the generation model (an OpenRouter model id). Only the worker gets the key, and
# `setup` asks for it only while WORKER_ENABLED=true. direct: OpenAI's and DeepSeek's own APIs.
LLM_GATEWAY=openrouter
LLM_PROVIDER=deepseek
# deepseek-v4-flash (2026-11-07 live G-gen, 26 cases, v2 prompts): 24/26 first pass vs 22, 0 unsupported claims vs 3,
# median USD 0.000122 vs 0.000678, p95 4.4 s vs 16.1 s. Needs pipeline >= v0.3.2 (reasoning off). Rollback: deepseek/deepseek-chat.
LLM_MODEL_DEFAULT=deepseek/deepseek-v4-flash
# The vision model of photo facts, an OpenAI id (sent as openai/gpt-4o under openrouter; a value
# with a vendor prefix is refused at worker boot). gpt-4o, 2026-11-09 live G-photo (synthetic set):
# every bar met, 0 confident errors, about USD 0.004 per product. Needs pipeline >= v0.5.0 (the
# gpt-4o price). Rollback: blank (the Settings default gpt-4o-mini).
LLM_MODEL_VISION=gpt-4o
# SI12: the vision model of the size-chart read only, an OpenAI id such as gpt-4o (sent as
# openai/<model> under openrouter). Blank: LLM_MODEL_VISION. Needs a PIPELINE_REF that prices the
# model, or every read fails closed with no call.
LLM_MODEL_VISION_SIZE_CHART=
# SI12: the size-chart read, off while live G-size misses its bar (gpt-4o exact 0.78 vs 0.85,
# 2026-11-09): the api answers `unavailable` with no job and the product read hides the button.
SIZE_CHART_READ_ENABLED=true
# SI14: the V1.1 assist switches, each off until its gate passes (docs/runbooks/V1-1-SWITCHES.md):
# the category classifier (G-classify), the column mapper's AI step (30 seller sheets), the lamps
# category (the read-only lamps count first, then the G-gen lamp cases) and the photo QA warnings
# (100 labelled images). No per-purpose LLM_GATEWAY_* is set: every model call keeps LLM_GATEWAY.
# On 2026-11-09 as a beta by the user's decision in chat: the live gate runs passed on synthetic sets
# smaller than the runbook's (G-classify 40 of 200 products, G-columns 15 of 30 sheets, G-photoqa
# 14 of 100 photos), recorded as an exception, not as the gate met. Re-run on the client's real sets
# when they arrive. The seller confirms every category and column; photo QA only warns.
CATEGORY_SUGGEST_ENABLED=true
COLUMN_MAP_AI_ENABLED=true
CATEGORY_LAMPS_ENABLED=false
PHOTO_QA_ENABLED=true
# Daily caps in USD for the api's generate precheck and the worker alike: the whole platform, and
# each tenant without its own cap.
LLM_DAILY_BUDGET_USD=3
LLM_TENANT_DAILY_BUDGET_USD=1
# SI7 (ADR-0030): the AI white-background edit, off until the user's live call (CODE-PLAN P5).
# On needs LLM_GATEWAY=openrouter. Blank values keep the Settings defaults
# (google/gemini-2.5-flash-image, 10 AI edits per tenant per UTC day, 0.5 of the platform cap).
IMAGE_EDIT_ENABLED=true
LLM_MODEL_IMAGE_EDIT=
IMAGE_EDIT_TENANT_DAILY_LIMIT=
IMAGE_EDIT_PLATFORM_DAILY_SHARE=
# Requests a minute per tenant on the api (SI5: a CSV import day plus a team on the review queue).
RATE_LIMIT_PER_TENANT_PER_MIN=600

# ---- app flags ----
# true (the sandbox host) until the SP-API application clears; then false (the production host).
# The app cleared on 2026-11-05 (developer profile approved, app registered as a draft).
AMAZON_USE_SANDBOX=false
FLIPKART_ENABLED=false
# The Amazon publish kill switch (true | false; deploy.sh refuses anything else and sends it to
# every role). false: no listing PUT, PATCH or VALIDATION_PREVIEW dry run reaches Amazon and no
# publish job is enqueued; reads, the status sync and connect still work. The owner asked on
# 2026-11-09 that the real seller account receives no publishes until they say go: keep false
# until then, and flip it only here plus a release.
AMAZON_PUBLISH_ENABLED=false
# DPP-1 (ADR-0021): off | all. Switch only here plus a release; a value set by hand on Cloud Run is
# wiped by the next deploy (`--env-vars-file` replaces every env var).
MFA_ENFORCEMENT=all
# ISO 8601 with an offset, e.g. 2026-11-20T00:00:00+05:30; required when MFA_ENFORCEMENT=all (a
# past date means no grace).
MFA_GRACE_UNTIL=2026-11-12T00:00:00+05:30

# ---- the Amazon SP-API app (docs/EXTERNAL-SETUP.md) ----
# AMAZON_APP_ID is the switch. Blank: Amazon connect stays off (it answers 501) and no secret is
# bound. Set (amzn1.sp.solution.<uuid>): AMAZON_CLIENT_ID (the LWA client id, public) and an https
# AMAZON_AUTHORIZE_URL are required, `setup` asks for AMAZON_CLIENT_SECRET (Secret Manager), and
# the api and the worker get all four. A draft app consents only with `?version=beta`; drop it once
# the app is published.
AMAZON_APP_ID=amzn1.sp.solution.c2233475-498e-4497-bd99-4bb90afe6ed2
AMAZON_CLIENT_ID=amzn1.application-oa2-client.fe086daf8bfa4d6488854a5cc8ece187
AMAZON_AUTHORIZE_URL=https://sellercentral.amazon.in/apps/authorize/consent?version=beta

# ---- Google sign-in (ADR-0020; docs/runbooks/GOOGLE-SIGNIN.md) ----
# true | false. Switch only here plus a same-image redeploy (`--env-vars-file` replaces every env
# var). With true, `setup` asks for the GOOGLE_OAUTH_CLIENT_SECRET value (Secret Manager) and the
# api gets it; with false the secret is never bound.
GOOGLE_OAUTH_ENABLED=true
# The Web application client id from the Google Cloud console (public, not a secret). Its one
# authorized redirect URI is $DASHBOARD_BASE_URL/api/v1/auth/google/callback.
GOOGLE_OAUTH_CLIENT_ID=1039991710726-74ijetqns5m41m2m3c6piso02j3vub2p.apps.googleusercontent.com

# ---- edge (DPP-2; docs/runbooks/EDGE-CUTOVER.md) ----
# The API's domain: on the global external load balancer with Cloud Armor (`deploy.sh prod edge`),
# or, while EDGE_PROVIDER=cloudflare, on Cloudflare in front of run.app.
EDGE_DOMAIN=api.kuinn.in
# ADR-0025: blank or armor (the load balancer path), or cloudflare (the interim edge until Cloud
# Armor quota returns; docs/runbooks/EDGE-CLOUDFLARE.md). cloudflare binds EDGE_ORIGIN_SECRET to
# the api, needs INGRESS=all and refuses the load balancer `edge` subcommands.
EDGE_PROVIDER=cloudflare
# ADR-0025: off | enforce. enforce answers 403 to any caller without the Worker's origin secret.
# The owner flips it only after the FE moved to the edge domain (EDGE-CLOUDFLARE.md order), plus a
# release; `deploy` then smokes run.app for 403 and the edge for 401.
ORIGIN_AUTH=enforce
# Cloud Run ingress: all, or internal-and-cloud-load-balancing once `edge lock-ingress` holds.
INGRESS=all
# Rule groups of armor-rules.yaml taken out of preview, quoted, in order (e.g. "path rate").
EDGE_ENFORCE=
# Optional pinned JWT issuer (https). Blank: the API's public URL, as before the edge.
JWT_ISSUER=https://aimos-api-ijm6inlc3a-el.a.run.app
# The one address `edge alerts` notifies (x@y.z): uptime, worker heartbeat and restarts,
# maintenance errors (V1 hardening #1; docs/runbooks/DEPLOY-GCP.md "Alerts and Slack"). The owner
# fills it in. Blank: `edge alerts` refuses.
ALERT_EMAIL=

# ---- daily maintenance (DPP 1.7; app.workers.maintenance) ----
# Cloud Scheduler cron and time zone for the maintenance job.
MAINT_SCHEDULE="0 3 * * *"
MAINT_TIME_ZONE=Asia/Kolkata
