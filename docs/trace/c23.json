   ],
   "page": "[221] Architectural Invariants",
   "kind": "requirement",
   "text": "The architectural invariants are non-negotiable architectural rules that must never be violated."
  },
  {
   "id": "R13684",
   "lines": [
    13684,
    13684
   ],
   "page": "[221] Architectural Invariants",
   "kind": "info",
   "text": "Keywords: architectural invariants, rules, non-negotiable, constraints",
   "why_not": "navigation"
  },
  {
