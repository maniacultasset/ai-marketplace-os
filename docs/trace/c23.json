    13686
   ],
   "page": "[221] Architectural Invariants",
   "kind": "info",
   "text": "Architectural Invariants",
   "why_not": "heading"
  },
  {
   "id": "R13688",
   "lines": [
    13688,
    13688
   ],
   "page": "[221] Architectural Invariants",
   "kind": "info",
   "text": "Never Violate These Rules",
   "why_not": "restatement",
   "dup_of": "R13683"
  },
  {
   "id": "R13690",
   "lines": [
    13690,
    13690
   ],
   "page": "[221] Architectural Invariants",
   "kind": "requirement",
   "text": "Invariant 1: AI never directly publishes to marketplaces."
  },
  {
   "id": "R13690a",
   "lines": [
    13690,
    13703
   ],
   "page": "[221] Architectural Invariants",
   "kind": "constraint",
   "text": "The Architectural Invariants list has 14 numbered invariants."
  },
  {
   "id": "R13691",
   "lines": [
    13691,
    13691
   ],
   "page": "[221] Architectural Invariants",
   "kind": "requirement",
   "text": "Invariant 2: Rules Engine is deterministic."
  },
  {
   "id": "R13691a",
   "lines": [
    13691,
    13691
   ],
   "page": "[221] Architectural Invariants",
   "kind": "requirement",
   "text": "Invariant 2: Rules Engine is never an LLM."
  },
  {
   "id": "R13692",
   "lines": [
    13692,
    13692
   ],
   "page": "[221] Architectural Invariants",
   "kind": "requirement",
   "text": "Invariant 3: Human approval is required in MVP."
  },
  {
   "id": "R13692a",
   "lines": [
    13692,
    13692
   ],
   "page": "[221] Architectural Invariants",
   "kind": "scope",
   "text": "Invariant 3: the human approval requirement is stated as applying in MVP."
  },
  {
   "id": "R13693",
   "lines": [
    13693,
    13693
   ],
   "page": "[221] Architectural Invariants",
   "kind": "requirement",
   "text": "Invariant 4: Marketplace-specific logic belongs inside adapters only."
  },
  {
   "id": "R13694",
   "lines": [
    13694,
    13694
   ],
   "page": "[221] Architectural Invariants",
   "kind": "data",
   "text": "Invariant 5: Canonical listing model is marketplace-independent."
  },
  {
   "id": "R13695",
   "lines": [
    13695,
    13695
   ],
   "page": "[221] Architectural Invariants",
   "kind": "quality",
   "text": "Invariant 6: Tenant isolation is mandatory on every query."
  },
  {
   "id": "R13696",
   "lines": [
    13696,
    13696
   ],
   "page": "[221] Architectural Invariants",
   "kind": "quality",
   "text": "Invariant 7: Marketplace credentials are encrypted at rest."
  },
  {
   "id": "R13696a",
   "lines": [
    13696,
    13696
   ],
   "page": "[221] Architectural Invariants",
   "kind": "decision",
   "text": "Invariant 7: Marketplace credentials encryption at rest uses AES-256."
  },
  {
   "id": "R13697",
   "lines": [
    13697,
    13697
   ],
   "page": "[221] Architectural Invariants",
   "kind": "quality",
   "text": "Invariant 8: All AgentRuns are observable."
  },
  {
   "id": "R13697a",
   "lines": [
    13697,
    13697
   ],
   "page": "[221] Architectural Invariants",
   "kind": "requirement",
   "text": "Invariant 8: All AgentRuns are persisted."
  },
  {
   "id": "R13698",
   "lines": [
    13698,
    13698
   ],
   "page": "[221] Architectural Invariants",
   "kind": "interface",
   "text": "Invariant 9: All failures use structured ErrorReport contracts."
  },
  {
   "id": "R13699",
   "lines": [
    13699,
    13699
   ],
   "page": "[221] Architectural Invariants",
   "kind": "requirement",
   "text": "Invariant 10: Retries are bounded."
  },
  {
   "id": "R13699a",
   "lines": [
    13699,
    13699
   ],
   "page": "[221] Architectural Invariants",
   "kind": "constraint",
   "text": "Invariant 10: retries are bounded at max 3 for agent corrections."
  },
  {
   "id": "R13700",
   "lines": [
    13700,
    13700
   ],
   "page": "[221] Architectural Invariants",
   "kind": "requirement",
   "text": "Invariant 11: Marketplace mutations are idempotent."
  },
  {
   "id": "R13701",
   "lines": [
    13701,
    13701
   ],
   "page": "[221] Architectural Invariants",
   "kind": "requirement",
   "text": "Invariant 12: Failed fields are retried individually, not the entire listing."
  },
  {
   "id": "R13702",
   "lines": [
    13702,
    13702
   ],
   "page": "[221] Architectural Invariants",
   "kind": "requirement",
   "text": "Invariant 13: Optimization Agent runs on schedule, not continuously."
  },
  {
   "id": "R13703",
   "lines": [
    13703,
    13703
   ],
   "page": "[221] Architectural Invariants",
   "kind": "requirement",
   "text": "Invariant 14: Future marketplaces don't require rewriting the core system."
  },
  {
   "id": "R13705",
   "lines": [
    13705,
    13705
   ],
   "page": "[221] Architectural Invariants",
   "kind": "info",
   "text": "These invariants are the foundation of the system's reliability, security, and extensibility.",
   "why_not": "context-prose"
  },
  {
   "id": "R13705a",
   "lines": [
    13705,
    13705
   ],
   "page": "[221] Architectural Invariants",
   "kind": "requirement",
   "text": "Any modification to the codebase — by a human or an AI coding agent — must preserve these invariants."
  },
  {
   "id": "R13707",
   "lines": [
    13707,
    13707
   ],
   "page": "[221] Architectural Invariants",
   "kind": "info",
   "text": "AI Implementation Context",
   "why_not": "heading"
  },
  {
   "id": "R13709",
   "lines": [
    13709,
    13709
   ],
   "page": "[221] Architectural Invariants",
   "kind": "requirement",
   "text": "For an AI coding agent reading this: these invariants are non-negotiable."
  },
  {
   "id": "R13709a",
   "lines": [
    13709,
    13709
   ],
   "page": "[221] Architectural Invariants",
   "kind": "requirement",
   "text": "AI coding agent: Do not bypass the Rules Engine."
  },
  {
   "id": "R13709b",
   "lines": [
    13709,
    13709
   ],
   "page": "[221] Architectural Invariants",
   "kind": "requirement",
   "text": "AI coding agent: do not allow direct publishing."
  },
  {
   "id": "R13709c",
   "lines": [
    13709,
    13709
   ],
   "page": "[221] Architectural Invariants",
   "kind": "requirement",
   "text": "AI coding agent: do not mix marketplace logic into the canonical model."
  },
  {
   "id": "R13709d",
   "lines": [
    13709,
    13709
   ],
   "page": "[221] Architectural Invariants",
   "kind": "requirement",
   "text": "AI coding agent: do not remove tenant isolation."
  },
  {
   "id": "R13709e",
   "lines": [
    13709,
    13709
   ],
   "page": "[221] Architectural Invariants",
   "kind": "flow",
   "text": "If a change appears to conflict with an invariant, escalate to a human architect."
  },
